# Reference for application configuration names, NOT automatically loaded by Java.
# Native local handoff uses tools/local/setup.ps1 and .local/database.json instead.
# For a separately approved team deployment, supply these through the process environment.
APP_ENV=test
APP_BASE_URL=http://127.0.0.1:18082/ticketscenter
APP_SECRET_KEY=
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=
DB_ENCRYPT=false
DB_TRUSTSERVERCERTIFICATE=true
DB_AUTH_USER=
DB_AUTH_PASSWORD=
DB_BUYER_USER=
DB_BUYER_PASSWORD=
DB_MANAGER_USER=
DB_MANAGER_PASSWORD=
DB_CHECK_IN_USER=
DB_CHECK_IN_PASSWORD=
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=
DB_WORKER_USER=
DB_WORKER_PASSWORD=
# Pool keys contain hyphens; set hikari.maximum-pool-size/minimum-idle/pool-budget
# in private Java properties. run.ps1 sets the bounded local pool automatically.
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=
VNPAY_API_URL=
VNPAY_RETURN_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ADMIN_SEED_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
