# Copy to .local/azure.properties. Fill credentials locally; never commit the private file.
# This is the shared Azure database, not a local database or a data import.
db.host=ticketscenter.database.windows.net
db.port=1433
db.name=TicketsCenter
db.user=
db.password=
db.encrypt=true
db.trustServerCertificate=false
db.loginTimeout=15

# Optional: use separately provisioned runtime users instead of the shared db.user fallback.
# db.auth.user=
# db.auth.password=
# db.buyer.user=
# db.buyer.password=
# db.manager.user=
# db.manager.password=
# db.check_in.user=
# db.check_in.password=
# db.admin.user=
# db.admin.password=
# db.worker.user=
# db.worker.password=

# For identical QR signing/verification across machines, obtain the existing app secret privately.
# If blank, the launcher creates and retains a private local key for this machine.
app.secret.key=
app.data.mode=real
admin.seed.enabled=false
demo.seed.enabled=false
mail.outbox.enabled=false
