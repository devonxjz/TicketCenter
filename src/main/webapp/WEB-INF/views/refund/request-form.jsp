<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.List,vn.ticketscenter.fulfillment.refund.repository.RefundRequestStore.OrderOption" %>
<%! private static String h(Object v){return v==null?"":v.toString().replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");} %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Yêu cầu hoàn vé · TicketCenter</title>
<style>body{margin:0;background:#f4f6fa;color:#17213a;font:16px system-ui}main{max-width:860px;margin:40px auto;padding:28px;background:white;border-radius:16px}a{color:#334eca}h1{margin-top:18px}label{display:block;margin:16px 0 8px}select,textarea,button{font:inherit;padding:12px;border:1px solid #cbd1de;border-radius:8px}select,textarea{box-sizing:border-box;width:100%}button{background:#334eca;color:white;cursor:pointer}button:disabled{opacity:.5;cursor:default}.policy{background:#eff3ff;padding:18px;border-radius:10px;line-height:1.6}.ticket{padding:14px;border-bottom:1px solid #dde2ee}.ticket label{display:flex;gap:12px}.muted{color:#5c6782;font-size:14px}.total{font-size:22px;font-weight:700;margin:22px 0}#message{padding:12px;white-space:pre-wrap}dialog{max-width:480px;border:1px solid #cbd1de;border-radius:16px;padding:28px}dialog::backdrop{background:#17213a88}@media(max-width:600px){main{margin:12px;padding:18px}}</style></head>
<body><main id="app" data-base="<%=h(request.getContextPath())%>" data-csrf="<%=h(request.getAttribute("csrf"))%>" data-order="<%=h(request.getAttribute("selectedOrder"))%>">
<a href="<%=h(request.getContextPath())%>/my-refunds">← Theo dõi yêu cầu của tôi</a><h1>Yêu cầu hoàn vé</h1>
<p class="policy">Chỉ gửi trước giờ bắt đầu sự kiện, với vé chưa sử dụng. Số tiền hoàn là số tiền thực trả của từng vé. Vé được chọn sẽ ngừng dùng để vào cửa ngay khi gửi yêu cầu và chờ quản trị duyệt.</p>
<label for="order">Chọn đơn hàng đã thanh toán</label><select id="order"><option value="">Chọn đơn hàng</option>
<% for(var order:(List<OrderOption>)request.getAttribute("refundOrders")){ %><option value="<%=h(order.orderId())%>"><%=h(order.orderCode())%> · <%=h(order.eventName())%></option><% } %></select>
<div id="tickets" aria-live="polite"></div><p id="total" class="total">Số tiền dự kiến: 0 ₫</p>
<form id="form"><label for="reason">Lý do hoàn vé (10–500 ký tự)</label><textarea id="reason" rows="4" minlength="10" maxlength="500" required></textarea><p class="muted">Yêu cầu sẽ được kiểm tra lại theo trạng thái vé và thời gian trên hệ thống.</p><button id="submit" disabled>Kiểm tra và gửi yêu cầu</button></form><div id="message" role="status"></div>
<dialog id="confirm"><h2>Xác nhận yêu cầu</h2><p id="confirmation"></p><p>Những vé này sẽ chuyển sang chờ hoàn tiền và không thể check-in.</p><button id="send">Đồng ý gửi</button> <button id="cancel" type="button">Quay lại</button></dialog>
</main><script>
(()=>{'use strict';const app=document.querySelector('#app'),base=app.dataset.base,order=document.querySelector('#order'),tickets=document.querySelector('#tickets'),reason=document.querySelector('#reason'),msg=document.querySelector('#message'),submit=document.querySelector('#submit'),dialog=document.querySelector('#confirm');let choices=[],busy=false,pending=null,key=null,previousBody=null,load=0;
const money=n=>BigInt(n).toLocaleString('vi-VN')+' ₫';const selected=()=>choices.filter(t=>tickets.querySelector('input[data-id="'+t.ticketId+'"]')?.checked);
function total(){const list=selected();document.querySelector('#total').textContent='Số tiền dự kiến: '+money(list.reduce((a,t)=>a+BigInt(t.paidAmount),0n));submit.disabled=busy||list.length===0;}
async function api(url,options={}){const r=await fetch(base+url,{credentials:'same-origin',...options});const body=await r.json();if(!r.ok)throw new Error(body.error?.message||'Không thể thực hiện yêu cầu.');return body.data;}
order.addEventListener('change',async()=>{const generation=++load;tickets.replaceChildren();choices=[];total();msg.textContent='';if(!order.value)return;msg.textContent='Đang tải vé…';try{const rows=await api('/api/orders/'+encodeURIComponent(order.value)+'/refundable-tickets');if(generation!==load)return;choices=rows;msg.textContent=rows.length?'':'Đơn hàng không có vé.';for(const t of rows){const row=document.createElement('div');row.className='ticket';const label=document.createElement('label'),input=document.createElement('input');input.type='checkbox';input.dataset.id=t.ticketId;input.disabled=!t.isRefundable;input.addEventListener('change',total);const text=document.createElement('span');text.textContent=t.ticketCode+' · '+t.seatLabel+' · '+money(t.paidAmount);label.append(input,text);row.append(label);if(t.unrefundableReason){const p=document.createElement('p');p.className='muted';p.textContent=t.unrefundableReason;row.append(p);}tickets.append(row);}total();}catch(e){if(generation===load)msg.textContent=e.message;}});
document.querySelector('#form').addEventListener('submit',e=>{e.preventDefault();if(busy||!selected().length)return;pending={orderId:order.value,ticketIds:selected().map(t=>t.ticketId),reason:reason.value.trim()};if([...pending.reason].length<10){msg.textContent='Lý do cần ít nhất 10 ký tự.';return;}const body=JSON.stringify(pending);if(body!==previousBody){key=crypto.randomUUID();previousBody=body;}document.querySelector('#confirmation').textContent='Bạn chọn '+pending.ticketIds.length+' vé. '+document.querySelector('#total').textContent;dialog.showModal();});
document.querySelector('#cancel').onclick=()=>dialog.close();document.querySelector('#send').onclick=async()=>{dialog.close();busy=true;order.disabled=true;reason.disabled=true;total();msg.textContent='Đang gửi yêu cầu…';try{const result=await api('/api/refund-requests',{method:'POST',headers:{'Content-Type':'application/json','X-CSRF-Token':app.dataset.csrf,'Idempotency-Key':key},body:JSON.stringify(pending)});msg.textContent=result.message+'\nSố tiền: '+money(result.totalRefundAmount);pending=null;key=null;previousBody=null;order.disabled=false;order.dispatchEvent(new Event('change'));location.assign(base+'/my-refunds');}catch(e){msg.textContent=e.message+' Bạn có thể bấm gửi lại cùng yêu cầu.';}finally{busy=false;order.disabled=false;reason.disabled=false;total();}};
if(app.dataset.order&&[...order.options].some(o=>o.value===app.dataset.order)){order.value=app.dataset.order;order.dispatchEvent(new Event('change'));}
})();</script></body></html>
