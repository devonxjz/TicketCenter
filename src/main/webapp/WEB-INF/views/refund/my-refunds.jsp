<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="vn.ticketscenter.fulfillment.refund.dto.RefundPageDto,java.math.BigDecimal,java.text.NumberFormat,java.util.Locale" %>
<%! private static String h(Object v){return v==null?"":v.toString().replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}
private static String status(String s){return switch(s){case "REQUESTED"->"Chờ duyệt";case "APPROVED"->"Đã duyệt, chờ chuyển tiền";case "PROCESSING"->"Đang chuyển tiền";case "COMPLETED"->"Đã hoàn tiền";case "REJECTED"->"Bị từ chối";case "RETRYABLE"->"Chuyển tiền thất bại, cần xử lý";case "NEEDS_RECONCILIATION"->"Đang xác minh giao dịch";default->s;};} %>
<% var result=(RefundPageDto)request.getAttribute("refundPage"); %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Yêu cầu hoàn vé của tôi</title><style>body{background:#f4f6fa;color:#17213a;font:16px system-ui}main{max-width:1000px;margin:36px auto;padding:24px;background:#fff;border-radius:16px}article{padding:20px 0;border-bottom:1px solid #dde2ee}.badge{padding:6px 12px;border-radius:16px;background:#fff0bb}.COMPLETED{background:#d9f7e4}.REJECTED{background:#ffdfe3}a{color:#334eca}small{color:#5c6782;word-break:break-all}pre{white-space:pre-wrap}button{padding:10px;font:inherit}nav{margin-top:24px;display:flex;gap:20px}#details{white-space:pre-wrap;line-height:1.6}dialog{max-width:680px;border-radius:12px;border:1px solid #cbd1de;padding:24px}</style></head><body><main data-base="<%=h(request.getContextPath())%>"><a href="<%=h(request.getContextPath())%>/refund-requests">+ Gửi yêu cầu hoàn vé</a><h1>Yêu cầu hoàn vé của tôi</h1><p><%=result.total()%> yêu cầu · trang <%=result.page()%></p>
<% if(result.items().isEmpty()){ %><p>Chưa có yêu cầu trên trang này.</p><% } for(var r:result.items()){ %>
<article><span class="badge <%=h(r.status())%>"><%=h(status(r.status()))%></span><h2><%=h(r.eventName())%></h2><p><%=r.ticketCount()%> vé · <%=h(NumberFormat.getIntegerInstance(Locale.forLanguageTag("vi-VN")).format(new BigDecimal(r.totalRefundAmount())))%> ₫</p><small>Mã yêu cầu: <%=h(r.refundId())%> · <time><%=h(r.createdAt())%></time></small><pre>Lý do: <%=h(r.reason())%></pre><% if(r.rejectionReason()!=null){ %><pre>Lý do từ chối: <%=h(r.rejectionReason())%></pre><% } %><button type="button" data-id="<%=h(r.refundId())%>">Xem tiến độ và vé</button></article><% } %>
<nav><% if(result.page()>1){ %><a href="?page=<%=result.page()-1%>&amp;pageSize=<%=result.pageSize()%>">← Trang trước</a><% } if((long)result.page()*result.pageSize()<result.total()){ %><a href="?page=<%=result.page()+1%>&amp;pageSize=<%=result.pageSize()%>">Trang sau →</a><% } %></nav>
<dialog id="dialog"><h2>Tiến độ hoàn vé</h2><div id="details" role="status"></div><button id="close">Đóng</button></dialog></main><script>(()=>{const dialog=document.querySelector('#dialog'),details=document.querySelector('#details'),base=document.querySelector('main').dataset.base;document.querySelector('#close').onclick=()=>dialog.close();document.querySelectorAll('button[data-id]').forEach(b=>b.onclick=async()=>{details.textContent='Đang tải…';dialog.showModal();try{const r=await fetch(base+'/api/refund-requests/'+b.dataset.id,{credentials:'same-origin'}),j=await r.json();if(!r.ok)throw new Error(j.error?.message);const d=j.data;details.textContent='Trạng thái: '+d.refund.status+'\n'+(d.refund.rejectionReason?'Lý do từ chối: '+d.refund.rejectionReason+'\n':'')+'\nVé:\n'+d.tickets.map(t=>t.ticketCode+' · '+t.seatLabel+' · '+t.status).join('\n')+'\n\nLịch sử chuyển tiền:\n'+(d.attempts.map(a=>'Lần '+a.attemptNo+': '+a.status+' · '+a.createdAt).join('\n')||'Chưa có lần chuyển tiền.');}catch(e){details.textContent=e.message||'Không thể tải tiến độ.';}});})();</script></body></html>
