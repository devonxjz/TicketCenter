<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Chính sách hoa hồng · TicketCenter</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/finance.css"></head>
<body><main id="finance-app" data-context="<c:out value='${pageContext.request.contextPath}'/>" data-page="commission" data-csrf="<c:out value='${csrf}'/>">
<nav><a href="${pageContext.request.contextPath}/finance/overview">Tổng quan</a> <a href="${pageContext.request.contextPath}/finance/settlements">Quyết toán</a> <a href="${pageContext.request.contextPath}/finance/reports">Báo cáo</a> <a href="${pageContext.request.contextPath}/finance/audit">Nhật ký</a></nav>
<h1>Chính sách hoa hồng</h1><p>Chọn tổ chức để xem lịch sử và thiết lập chính sách. Chính sách đã gắn với sự kiện được khóa sửa.</p>
<label>Tổ chức <select id="organization" required><option value="">Chọn tổ chức</option><c:forEach var="org" items="${organizations}"><option value="<c:out value='${org.id}'/>"><c:out value="${org.name}"/></option></c:forEach></select></label>
<p id="notice" role="status" aria-live="polite"></p><div class="scroll"><table><thead><tr><th>Tỷ lệ (%)</th><th>Phí cố định (VND)</th><th>Từ ngày</th><th>Đến ngày</th><th>Sự kiện áp dụng</th><th>Thao tác</th></tr></thead><tbody id="rules"></tbody></table></div>
<form id="commission-form"><h2 id="form-title">Thêm chính sách</h2><input type="hidden" name="ruleId"><label>Tỷ lệ (%)<input name="ratePercent" type="number" min="0" max="100" step="0.0001" required></label><label>Phí cố định (VND)<input name="fixedFee" inputmode="numeric" pattern="[0-9]+" required></label><label>Áp dụng từ (UTC)<input name="effectiveFrom" type="datetime-local" step="1" required></label><label>Áp dụng đến (UTC)<input name="effectiveTo" type="datetime-local" step="1" required></label><button type="submit">Lưu chính sách</button><button id="cancel-edit" type="button">Hủy chỉnh sửa</button></form>
</main><script src="${pageContext.request.contextPath}/assets/js/finance-workbench.js" defer></script></body></html>
