<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="vn.ticketscenter.settlement.controller.FinanceHtml" %>
<% request.setAttribute("financeTitle", "Chính sách hoa hồng"); request.setAttribute("financePage", "commission"); request.setAttribute("financeAdmin", true); request.setAttribute("financeWritable", true); request.setAttribute("financeIntro", "Thiết lập tỷ lệ và phí cố định theo tổ chức. Chính sách đã gắn với sự kiện được khóa sửa để giữ nguyên lịch sử tính phí."); %>
<%@ include file="../../finance/_header.jsp" %>
<section class="finance-panel"><div class="finance-panel-heading"><h2>Chính sách theo tổ chức</h2><span class="finance-tag">Quản lý phí</span></div>
<label>Tổ chức <select id="organization" required><option value="">Chọn tổ chức</option><%= FinanceHtml.options(request.getAttribute("organizations"),"name") %></select></label>
<div class="scroll" tabindex="0" aria-label="Danh sách chính sách hoa hồng"><table><caption class="finance-table-caption">Lịch sử chính sách hoa hồng</caption><thead><tr><th>Tỷ lệ (%)</th><th>Phí cố định (VND)</th><th>Từ ngày UTC</th><th>Đến ngày UTC</th><th>Sự kiện áp dụng</th><th>Thao tác</th></tr></thead><tbody id="rules"></tbody></table></div></section>
<section class="finance-panel"><form id="commission-form" class="finance-filter-grid"><h2 id="form-title">Thêm chính sách</h2><input type="hidden" name="ruleId"><label>Tỷ lệ (%)<input name="ratePercent" type="number" min="0" max="100" step="0.0001" required></label><label>Phí cố định (VND)<input name="fixedFee" inputmode="numeric" pattern="[0-9]+" required></label><label>Áp dụng từ (UTC)<input name="effectiveFrom" type="datetime-local" step="1" required></label><label>Áp dụng đến (UTC)<input name="effectiveTo" type="datetime-local" step="1" required></label><div class="finance-form-actions"><button type="submit">Lưu chính sách</button><button id="cancel-edit" class="finance-button-secondary" type="button">Hủy chỉnh sửa</button></div></form></section>
<%@ include file="../../finance/_footer.jsp" %>
