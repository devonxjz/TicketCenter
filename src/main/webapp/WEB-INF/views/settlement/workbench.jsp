<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Quyết toán · TicketCenter</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/finance.css"></head>
<body><main id="finance-app" data-context="<c:out value='${pageContext.request.contextPath}'/>" data-page="settlements" data-csrf="<c:out value='${csrf}'/>" data-payout-mode="<c:out value='${payoutMode}'/>">
<nav><a href="${pageContext.request.contextPath}/finance/overview">Tổng quan</a> <a href="${pageContext.request.contextPath}/finance/commission">Hoa hồng</a> <a href="${pageContext.request.contextPath}/finance/reports">Báo cáo</a> <a href="${pageContext.request.contextPath}/finance/audit">Nhật ký</a></nav>
<h1>Quyết toán sự kiện</h1><label>Sự kiện <select id="event" required><option value="">Chọn sự kiện</option><c:forEach var="event" items="${events}"><option value="<c:out value='${event.id}'/>"><c:out value="${event.title}"/></option></c:forEach></select></label>
<p id="notice" role="status" aria-live="polite"></p><dl id="summary"></dl><h2>Giao dịch cần giải quyết</h2><ul id="blockers"></ul>
<div class="actions"><button id="recalculate" disabled>Tính lại bảng kê</button><button id="confirm" disabled>Chốt quyết toán</button></div>
<h2>Chi trả</h2><c:choose><c:when test="${payoutMode == 'fixture-simulated'}"><p>Chế độ kiểm thử: lệnh chi trả được mô phỏng, không chuyển tiền ngân hàng thật.</p></c:when><c:otherwise><p>Chưa kết nối dịch vụ chi trả. Bạn vẫn có thể chốt bảng kê và xem lịch sử.</p></c:otherwise></c:choose>
<form id="payout-form"><label>Số tiền (VND)<input name="amount" inputmode="numeric" pattern="[0-9]+" required></label><label>Số tài khoản<input name="bankAccountNumber" maxlength="64" required></label><label>Ngân hàng<input name="bankName" maxlength="100" required></label><label>Tên chủ tài khoản<input name="accountHolderName" maxlength="200" required></label><label>Ghi chú<input name="note" maxlength="500"></label><button id="payout-submit" type="submit" disabled>Tạo lệnh chi trả</button><button id="reconcile" type="button" hidden>Xác minh lại kết quả đang chờ</button></form>
<h2>Lịch sử chi trả</h2><div class="scroll"><table><thead><tr><th>Thời gian</th><th>Số tiền (VND)</th><th>Trạng thái</th><th>Mã chuyển tiền</th></tr></thead><tbody id="payouts"></tbody></table></div>
</main><script src="${pageContext.request.contextPath}/assets/js/finance-workbench.js" defer></script></body></html>
