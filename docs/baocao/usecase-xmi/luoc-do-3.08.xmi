  <uml:Model xmi:type="uml:Model" xmi:id="EAID_C982BD6F_42AA_5A6F_A7D9_46699967F2D0" name="EA_Model" visibility="public">
    <packagedElement xmi:type="uml:Package" xmi:id="EAPK_D596F530_0AFE_5F29_8303_ED2913232DB7" name="Luoc do 3.08 - Use case quan ly ve va kiem soat vao cua" visibility="public">
      <ownedComment xmi:type="uml:Comment" xmi:id="EAID_506D6AAA_14B0_5E28_A853_59904EA8A073">
        <body>Nguon: BAOCAO.md muc3.1-3.4; SPEC.md muc6.8. Day la goi doc lap de nhap vao Sparx Enterprise Architect.</body>
      </ownedComment>
      <packagedElement xmi:type="uml:Actor" xmi:id="EAID_8FB36C5B_BED4_52F1_A41E_32776E0AC112" name="Nguoi mua da xac minh email" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_1E91F587_5626_55E8_99CE_0C7F06C44705">
          <body>Nguon: BAOCAO.md muc3.1; SPEC.md muc4.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Actor" xmi:id="EAID_633E64C8_9426_5581_8D68_9BBDD906D91F" name="Quan ly to chuc" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_8A7ED916_FE3A_5426_961B_B162EF7D61D7">
          <body>Nguon: BAOCAO.md muc3.1; SPEC.md muc4.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Actor" xmi:id="EAID_3553BF37_8CD2_5FB6_ABF4_9CF16A702C16" name="Nhan vien kiem soat ve" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_1D42A1C1_7D45_50F1_996C_367D0882BB9D">
          <body>Nguon: BAOCAO.md muc3.1; SPEC.md muc4.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_7D3C62A7_8AA9_5C08_9916_B0F1CF8CCE7E" name="Xem don mua ve va ve dien tu" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_A1C064E3_1D86_5BEC_B0CF_6FE17F41C273">
          <body>BAOCAO.md muc3.4.13: Cho phep nguoi mua xem cac don thuoc tai khoan minh va cac ve dien tu da duoc phat hanh.
Doi chieu: SPEC.md muc6.8.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_35B3399C_A4CF_58E9_98C1_6ABC9E478EB8" name="Chia se ma QR cua ve" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_CADD8E0F_4BFD_59BD_88FC_83EF3F78F93F">
          <body>BAOCAO.md muc3.4.14: Cho phep nguoi mua cung cap ma QR cua mot ve cho nguoi di cung ma khong chuyen quyen so huu don.
Doi chieu: SPEC.md muc6.8.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_4797E3DD_4C1A_530B_A1CF_6F6CFED89F52" name="Kiem tra ve vao cua bang QR hoac ma nhap tay" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_AF609A6D_343E_55BA_9F7D_4BE6F726C42C">
          <body>BAOCAO.md muc3.4.26: Cho phep nhan su cua to chuc kiem tra ve tai cua bang camera hoac nhap ma thu cong theo cung mot quy trinh nghiep vu.
Doi chieu: SPEC.md muc6.8.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_8C20E6A1_E2C2_5AB4_9600_A3A796644F5A" name="Xem lich su kiem tra ve" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_527D3966_3B8B_5AD1_AA9D_63C455F6D949">
          <body>BAOCAO.md muc3.4.27: Cho phep nhan su duoc phan quyen xem cac lan kiem tra ve va ket qua trong pham vi to chuc.
Doi chieu: SPEC.md muc6.8.</body>
        </ownedComment>
      </packagedElement>
