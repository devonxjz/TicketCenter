  <uml:Model xmi:type="uml:Model" xmi:id="EAID_955E6D48_2DC4_5FC6_AE4C_1A30279D551E" name="EA_Model" visibility="public">
    <packagedElement xmi:type="uml:Package" xmi:id="EAPK_4DE93C90_B707_53F6_B763_907A4EB44C12" name="Luoc do 3.11 - Use case bao cao xuat du lieu va tra cuu nhat ky hoat dong" visibility="public">
      <ownedComment xmi:type="uml:Comment" xmi:id="EAID_CCA4BF7C_E2BB_56AC_A489_0B2CC7F79A4A">
        <body>Nguon: BAOCAO.md muc3.1-3.4; SPEC.md muc6.12. Day la goi doc lap de nhap vao Sparx Enterprise Architect.</body>
      </ownedComment>
      <packagedElement xmi:type="uml:Actor" xmi:id="EAID_3D7BB6F0_F873_5507_A4C8_7D1D62A3A099" name="Quan ly to chuc" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_905CA663_0A2D_56B5_BDF2_05878FE08C83">
          <body>Nguon: BAOCAO.md muc3.1; SPEC.md muc4.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Actor" xmi:id="EAID_C4F85FC8_B57C_58C4_89F1_5A6B4FFBD426" name="Quan tri nen tang" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_6E50ED5B_D885_52FD_BFB2_2E0E9EC16562">
          <body>Nguon: BAOCAO.md muc3.1; SPEC.md muc4.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_4C8CD866_00CF_55B0_9EC8_9D1876E80FEA" name="Xem va loc bao cao" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_7521EEA0_CEE4_54D5_A8A1_FAB236B68EA5">
          <body>BAOCAO.md muc3.4.35: Cho phep nguoi co quyen xem so lieu van hanh, doanh thu va kiem soat ve theo pham vi duoc cap.
Doi chieu: SPEC.md muc6.12.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_4A9C3610_328D_594C_8C34_662237A64F04" name="Xuat bao cao CSV" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_5B255AA9_C066_5585_806F_6E2CEE3E9B3A">
          <body>BAOCAO.md muc3.4.36: Cho phep nguoi co quyen xuat du lieu bao cao hien tai thanh tep CSV dung cung pham vi, cong thuc va bo loc voi giao dien.
Doi chieu: SPEC.md muc6.12.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_48A8FC40_1463_52B7_89E7_E3B494138B56" name="Xem nhat ky thao tac he thong" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_2258CC96_A057_5966_BE02_ADD3EA2A0C47">
          <body>BAOCAO.md muc3.4.37: Cho phep quan tri tra cuu lich su cac thao tac quan trong da duoc he thong ghi nhan.
Doi chieu: SPEC.md muc6.12.</body>
        </ownedComment>
      </packagedElement>
