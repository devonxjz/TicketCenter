  <xmi:Documentation exporter="Enterprise Architect" exporterVersion="6.5" exporterID="1721" />
  <uml:Model xmi:type="uml:Model" xmi:id="EAID_F9A93A75_E323_5A67_A7C5_0D13EF014C82" name="EA_Model" visibility="public">
    <packagedElement xmi:type="uml:Package" xmi:id="EAPK_11772746_5756_58F7_9DA0_C325376DCE21" name="Luoc do 3.03 - Use case dang ky xet duyet va quan ly to chuc" visibility="public">
      <ownedComment xmi:type="uml:Comment" xmi:id="EAID_B524E6CB_8A7D_5171_92DE_C2A1BCCCDE80">
        <body>Nguon: BAOCAO.md muc3.1-3.4; SPEC.md muc6.2. Day la goi doc lap de nhap vao Sparx Enterprise Architect.</body>
      </ownedComment>
      <packagedElement xmi:type="uml:Actor" xmi:id="EAID_BF54F6AC_9FDC_5214_95DF_DCEED002EAAB" name="Nguoi mua da xac minh email" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_B321DB9E_20D9_5C82_B5CE_B6828BE5E760">
          <body>Nguon: BAOCAO.md muc3.1; SPEC.md muc4.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Actor" xmi:id="EAID_6D5DCCEC_7224_5841_B476_712A79E6FA7C" name="Quan ly to chuc" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_20AB4857_2F73_58B9_AA0D_4D6E114758EE">
          <body>Nguon: BAOCAO.md muc3.1; SPEC.md muc4.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Actor" xmi:id="EAID_4267CA8A_A567_5477_A0D2_615ADA8D259C" name="Quan tri nen tang" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_3423D40A_E621_50FA_BBA6_C4070177E3CB">
          <body>Nguon: BAOCAO.md muc3.1; SPEC.md muc4.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_6951D995_BF18_5242_B1A4_E9E935BC6ACA" name="Gui yeu cau tao to chuc va xem ket qua" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_E4CC7258_6672_5DBC_967A_07CD6AF9805A">
          <body>BAOCAO.md muc3.4.16: Cho phep nguoi mua da xac minh de nghi tao mot to chuc va theo doi ket qua xet duyet.
Doi chieu: SPEC.md muc6.2.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_246D6336_5A1B_51AB_9E05_BF8DBD11F60E" name="Duyet hoac tu choi yeu cau tao to chuc" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_E8F3259F_EC4C_5358_A71E_8DA512C5EB30">
          <body>BAOCAO.md muc3.4.17: Quan tri duyet cung Organization tu PENDING_APPROVAL sang APPROVED, tao CommissionRule ban dau va cap MANAGER cho requester cung giao dich; tu choi giu REJECTED va ly do, duyet lap khong tao Organization thu hai.
Doi chieu: SPEC.md muc6.2.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_48452930_5E19_57C6_A351_08AB5744895E" name="Them thanh vien vao to chuc" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_5B3F739F_E301_56EB_9DF0_4A2B9DFA6E93">
          <body>BAOCAO.md muc3.4.18: Quan ly tim User da ton tai theo userName duy nhat va goi assignRole(org, role) de them truc tiep MANAGER/CHECK_IN_STAFF vao organizationRoles; khong co luong moi qua email.
Doi chieu: SPEC.md muc6.2.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_BD414459_5176_52C9_92BD_5DDDBE648C3E" name="Thay doi vai tro va vo hieu hoa thanh vien" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_4AC65191_D66B_5837_9BEC_F48D2D8215C0">
          <body>BAOCAO.md muc3.4.19: Quan ly thay doi organizationRoles hoac goi revokeRole(org) de bo quyen hieu luc; giu lich su tai persistence, khong vo hieu hoa User va khong loai MANAGER dang hoat dong cuoi cung.
Doi chieu: SPEC.md muc6.2.</body>
        </ownedComment>
      </packagedElement>
