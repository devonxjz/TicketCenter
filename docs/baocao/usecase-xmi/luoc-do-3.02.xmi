      <ownedComment xmi:type="uml:Comment" xmi:id="EAID_266C0AC5_4B46_5FC5_97F3_328115F96C54">
        <body>Nguon: BAOCAO.md muc3.1-3.4; SPEC.md muc6.1. Day la goi doc lap de nhap vao Sparx Enterprise Architect.</body>
      </ownedComment>
