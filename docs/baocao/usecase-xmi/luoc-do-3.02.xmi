      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_EC1D60D7_E25F_594A_92F5_C9447524FBB6" name="Dang ky tai khoan" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_801D3E73_BE13_5274_A41C_2875305567A8">
          <body>BAOCAO.md muc3.4.1: Cho phep khach dang ky voi userName duy nhat, email va mat khau; User mac dinh CUSTOMER, phai xac minh email truoc khi giu ve.
Doi chieu: SPEC.md muc6.1.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_28F41C98_9666_5677_AD28_C92A21B26729" name="Xac minh email bang OTP" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_6473EBD7_DDEB_5EE5_B182_74F12F35ADD9">
          <body>BAOCAO.md muc3.4.2: Cho phep nguoi dung xac minh dia chi email bang OTP truoc khi thuc hien thao tac giu ve.
Doi chieu: SPEC.md muc6.1.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_72AA1479_95CB_523C_94F4_E2D5067D35B9" name="Dang nhap" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_BB8E474B_8712_5897_9952_15E0696BC06C">
          <body>BAOCAO.md muc3.4.3: Cho phep nguoi dung dang nhap bang email va mat khau hop le, thiet lap phien phia may chu; quan tri local/demo dung admin / admin.
Doi chieu: SPEC.md muc6.1.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_ABBF9A56_8A8B_505B_A645_3BFED5862AAD" name="Dat lai mat khau bang OTP" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_0E962041_AF4A_5C8D_8E2C_C1F8558F801C">
          <body>BAOCAO.md muc3.4.4: Cho phep chu tai khoan dat mat khau moi sau khi xac minh OTP danh rieng cho muc dich dat lai mat khau.
Doi chieu: SPEC.md muc6.1.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_9C4EF585_C9C1_584B_A515_3C6D40A06EE2" name="Cap nhat ho so ca nhan" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_D17EDF4A_BB09_5424_B276_08B25F04567E">
          <body>BAOCAO.md muc3.4.5: Cho phep nguoi dung cap nhat ho ten va so dien thoai trong ho so ca nhan.
Doi chieu: SPEC.md muc6.1.</body>
        </ownedComment>
      </packagedElement>
