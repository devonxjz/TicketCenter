          <body>Nguon: BAOCAO.md muc3.1; SPEC.md muc4.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Actor" xmi:id="EAID_3C531776_C2E8_5866_B62B_20CC02EA280E" name="Nhan vien kiem soat ve" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_40FDD65C_4B5B_512D_886E_A285BE14B5FA">
