      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_A1082382_BCA8_568B_B0AD_F282C5D8E466" name="Ap dung va bo ma giam gia" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_84E3D471_4311_5FA0_800E_7A8717F68D99">
          <body>BAOCAO.md muc3.4.11: Cho phep nguoi mua ap dung toi da mot ma giam gia hop le hoac bo ma khoi don chua thanh toan.
Doi chieu: SPEC.md muc6.5.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_2ED702A5_9EEA_55C8_925C_A12334C8DCB3" name="Quan ly ma giam gia cua to chuc" visibility="public">
