  <uml:Model xmi:type="uml:Model" xmi:id="EAID_BD57B39D_FEA8_5A9D_AFDE_6ECCE76E4062" name="EA_Model" visibility="public">
    <packagedElement xmi:type="uml:Package" xmi:id="EAPK_C1AA7AAD_20C1_51AF_BED1_FCC98690090F" name="Luoc do 3.04 - Use case quan ly su kien khu vuc va ghe" visibility="public">
      <ownedComment xmi:type="uml:Comment" xmi:id="EAID_C23D8841_145C_543D_B50E_BFCB22CE2CED">
        <body>Nguon: BAOCAO.md muc3.1-3.4; SPEC.md muc6.3. Day la goi doc lap de nhap vao Sparx Enterprise Architect.</body>
      </ownedComment>
      <packagedElement xmi:type="uml:Actor" xmi:id="EAID_BD49917E_BBB9_5E4D_BD51_B509DDCCC721" name="Quan ly to chuc" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_D8F7B165_B2D2_5E9C_B644_59B205728C1B">
          <body>Nguon: BAOCAO.md muc3.1; SPEC.md muc4.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Actor" xmi:id="EAID_F7D32E74_8320_5B98_AAB4_FD37B9C7CFB3" name="Quan tri nen tang" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_E0032A0E_D653_5205_A1CD_76CA93534F06">
          <body>Nguon: BAOCAO.md muc3.1; SPEC.md muc4.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_D9E5A4F0_D37C_52E4_98B5_A5C1BE080512" name="Tao va chinh sua su kien" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_9ACD8F95_B2CB_5289_BA5C_96CF67623C52">
          <body>BAOCAO.md muc3.4.20: Cho phep quan ly tao ban nhap su kien va chinh sua thong tin truoc khi su kien duoc cong khai.
Doi chieu: SPEC.md muc6.3.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_CD21120D_1797_5486_AB58_A95D7ED1DF36" name="Thiet lap khu ngoi, ghe va khu dung" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_A475E465_6CA7_5154_B0D9_1F3BB4A2DDD4">
          <body>BAOCAO.md muc3.4.21: Cho phep quan ly cau hinh cac khu ban ve, ghe cua khu ngoi va suc chua cua khu dung cho su kien.
Doi chieu: SPEC.md muc6.3.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_70EAEBC9_D8B8_5848_9411_9A82FB289BBA" name="Cap nhat gia ve theo khu" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_DCBA2885_85C1_5719_90AD_DE723E2AB2D0">
          <body>BAOCAO.md muc3.4.22: Cho phep quan ly thay doi gia niem yet cua mot khu thuoc su kien cua to chuc minh.
Doi chieu: SPEC.md muc6.3.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_4BD9D94F_9C1E_5128_A45C_EC7863D927AA" name="Gui su kien de duyet" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_3F3FC0C8_8413_503F_8FE3_B123C6CBF78F">
          <body>BAOCAO.md muc3.4.23: Cho phep quan ly gui ban nhap hoac su kien da bi tu choi den quan tri de xet duyet cong khai.
Doi chieu: SPEC.md muc6.3.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_50A263C7_C254_5A6B_90CE_AC871172E85D" name="Duyet cong khai hoac tu choi su kien" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_73D34FAB_A051_5561_8673_6552A942C3CE">
          <body>BAOCAO.md muc3.4.24: Cho phep quan tri quyet dinh cong khai su kien hoac tu choi de to chuc chinh sua va gui lai.
Doi chieu: SPEC.md muc6.3.</body>
        </ownedComment>
      </packagedElement>
