  <uml:Model xmi:type="uml:Model" xmi:id="EAID_0124DD3C_1AC8_5BDB_8F8C_C67D73C0BA9B" name="EA_Model" visibility="public">
    <packagedElement xmi:type="uml:Package" xmi:id="EAPK_D1FE0E5C_93A5_50D3_9B41_D119F59A9CA7" name="Luoc do 3.05 - Use case tra cuu su kien giu ve va tao don hang" visibility="public">
      <ownedComment xmi:type="uml:Comment" xmi:id="EAID_46D2B344_DB6D_5646_BF24_6AC361437839">
        <body>Nguon: BAOCAO.md muc3.1-3.4; SPEC.md muc6.4. Day la goi doc lap de nhap vao Sparx Enterprise Architect.</body>
      </ownedComment>
      <packagedElement xmi:type="uml:Actor" xmi:id="EAID_164D7E10_1C05_5673_8FAB_E955B9FA6095" name="Khach chua dang nhap" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_04B0E7E1_3EEA_5477_847C_78F0A15EA21A">
          <body>Nguon: BAOCAO.md muc3.1; SPEC.md muc4.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Actor" xmi:id="EAID_726A9828_A9AD_50C1_A01F_BB4ACA973B84" name="Nguoi dung chua xac minh email" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_5FC8CB7D_8D96_5CB8_B9C9_3B4239780254">
          <body>Nguon: BAOCAO.md muc3.1; SPEC.md muc4.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Actor" xmi:id="EAID_CE9D7BB1_9E56_53AC_9E28_96A5BEFF3750" name="Nguoi mua da xac minh email" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_72B76862_45E4_5405_90CE_4698A2E3F02D">
          <body>Nguon: BAOCAO.md muc3.1; SPEC.md muc4.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_49CC4F53_738B_5983_BA55_C6446C104EB9" name="Tim kiem va loc su kien" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_83CF468C_8B03_5C48_9403_82B44801B7E6">
          <body>BAOCAO.md muc3.4.6: Cho phep nguoi dung tra cuu danh sach su kien cong khai theo ten, danh muc, khoang ngay va thu tu mong muon.
Doi chieu: SPEC.md muc6.4.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_08356A5C_71D0_5080_B2B8_E33861E54C60" name="Xem chi tiet su kien, gia ve va tinh trang cho" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_94C4F879_0D95_5D33_8F2F_509FDE6E42AC">
          <body>BAOCAO.md muc3.4.7: Cho phep nguoi dung xem thong tin cua su kien cong khai, cac khu ve, gia niem yet va tinh trang cho hien tai.
Doi chieu: SPEC.md muc6.4.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_37026818_A128_5171_B938_2C1B9A668D89" name="Chon cho va giu ve" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_C2775C48_2CE1_5D96_84B1_7F06F220D480">
          <body>BAOCAO.md muc3.4.8: Cho phep nguoi mua da xac minh giu toan bo ghe hoac so luong ve dung da chon trong 10 phut.
Doi chieu: SPEC.md muc6.4.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_3B712637_51A8_588C_BE08_7B43715DEA8B" name="Huy luot giu ve" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_71784065_4DA2_57FC_BE42_E9F72F0085A7">
          <body>BAOCAO.md muc3.4.9: Cho phep chu luot giu chu dong huy luot giu chua thanh toan de tra lai cho va quota lien quan.
Doi chieu: SPEC.md muc6.4.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_AE915F35_8A76_5734_81B7_56262A488503" name="Tao don mua ve" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_3112517F_F000_5A70_8E68_A6FFDA3495E3">
          <body>BAOCAO.md muc3.4.10: Cho phep nguoi mua tao duy nhat mot don hang tu luot giu con hieu luc.
Doi chieu: SPEC.md muc6.4.</body>
        </ownedComment>
      </packagedElement>
