  <uml:Model xmi:type="uml:Model" xmi:id="EAID_01E68ABD_27BB_513D_B1CA_0D3A58D55CFD" name="EA_Model" visibility="public">
    <packagedElement xmi:type="uml:Package" xmi:id="EAPK_63BD05DF_0656_560F_A3C3_D0BD796E2296" name="Luoc do 3.07 - Use case thanh toan va phat hanh ve" visibility="public">
      <ownedComment xmi:type="uml:Comment" xmi:id="EAID_E24652C4_FCEC_5583_815A_4231F8905F7B">
        <body>Nguon: BAOCAO.md muc3.1-3.4; SPEC.md muc6.6, muc6.7. Day la goi doc lap de nhap vao Sparx Enterprise Architect.</body>
      </ownedComment>
      <packagedElement xmi:type="uml:Actor" xmi:id="EAID_2B649419_FB9A_56F9_91BB_330807DB1985" name="Nguoi mua da xac minh email" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_2CB35A08_73AE_5BD1_8F95_5E0094BE43BE">
          <body>Nguon: BAOCAO.md muc3.1; SPEC.md muc4.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Actor" xmi:id="EAID_6C13972F_1754_51A4_96B3_1025DCF033E0" name="VNPAY Sandbox" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_C0B87A59_61BE_5CAF_BBAD_EE13E957E9C3">
          <body>Nguon: BAOCAO.md muc3.1; SPEC.md muc4.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_6691F6A6_C169_5846_B2FE_0504B8A7B724" name="Tao don mua ve" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_66F11358_A4A3_5142_B2CD_5AB462FE8162">
          <body>BAOCAO.md muc3.4.10: Cho phep nguoi mua tao duy nhat mot don hang tu luot giu con hieu luc.
Doi chieu: SPEC.md muc6.6, muc6.7.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_4BA4F820_6C30_5F1C_85F9_847F112BB1F3" name="Thanh toan qua VNPAY Sandbox" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_92568DD2_9D1D_5CA4_90B4_1119E09BB47D">
          <body>BAOCAO.md muc3.4.12: Moi Payment thuoc dung mot Order, Order co 0..* lan thu; acceptedPayment chon CAPTURED hop le. Chi ket qua may chu/IPN da xac thuc, Hold con han va Event con ban moi phat hanh ve. PENDING/UNKNOWN khong thu lai; thu muon/trung tao Refund PAYMENT_COMPENSATION khong co Ticket. Don 0d hoan tat khong tao Payment.
Doi chieu: SPEC.md muc6.6, muc6.7.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_39D8E5B7_2C09_5DCE_A427_81CA6B026A69" name="Xem don mua ve va ve dien tu" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="EAID_82483D3F_6779_591E_82DB_3F172F371FF5">
          <body>BAOCAO.md muc3.4.13: Cho phep nguoi mua xem cac don thuoc tai khoan minh va cac ve dien tu da duoc phat hanh.
Doi chieu: SPEC.md muc6.6, muc6.7.</body>
        </ownedComment>
      </packagedElement>
